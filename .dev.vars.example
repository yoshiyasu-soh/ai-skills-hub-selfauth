# ローカル開発用。このファイルをリポジトリ直下に `.dev.vars` としてコピーして使用してください
# (Gitには含めないこと)。
ENVIRONMENT=development

# 任意: Resend (https://resend.com) のAPIキー。未設定の場合、確認メール・パスワードリセットメールは
# 実送信されず、ターミナルにリンクがログ出力されるだけになる(ローカル動作確認はこれで可能)。
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 任意: メール送信をCloudflare Email Service経由にする場合(Workers Paidプラン限定)。
# 詳細は docs/setup-selfauth.md 参照。未設定時は "resend" として扱われる。
# EMAIL_PROVIDER=cloudflare
# EMAIL_FROM_ADDRESS=AI Skills Hub <no-reply@skills.example.com>

# 任意: 会員登録を特定ドメインのメールアドレスのみに制限したい場合。
# REGISTRATION_MODE=domain_restricted
# ALLOWED_EMAIL_DOMAINS=example.co.jp

# 任意: OSS紹介投稿のGitHub URL自動取得(GET /api/items/fetch-metadata)で使うGitHub Personal
# Access Token。未設定でも動作するが、GitHub APIの未認証レート制限(60回/時/IP)に達しやすい。
# 必要なスコープは public リポジトリの読み取りのみ(fine-grained PATなら
# Public Repositories only・Contents: Read-onlyで作成すれば十分)。
# https://github.com/settings/tokens から発行する。
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
