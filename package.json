{
  "name": "ai-skills-hub",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "worker",
    "frontend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "build:frontend": "npm run build --workspace frontend",
    "dev": "npm run build:frontend && wrangler dev",
    "deploy": "npm run build:frontend && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ai-skills-hub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ai-skills-hub-db --remote",
    "typecheck:worker": "npm run typecheck --workspace worker",
    "typecheck:frontend": "npm run typecheck --workspace frontend"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
